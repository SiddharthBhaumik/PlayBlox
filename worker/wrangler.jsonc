{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "playblox-party-service",
  "main": "src/index.js",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "PARTY_ROOMS",
        "class_name": "PartyRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PartyRoom"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
